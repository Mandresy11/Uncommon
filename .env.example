# Copier ce fichier en .env.local et remplir les valeurs
# NE JAMAIS committer .env.local sur git

# Clé API Resend (resend.com), nécessaire pour que le formulaire de contact
# envoie réellement un e-mail vers uncommonpeopletribe@gmail.com.
# Sans cette clé, le formulaire affiche une erreur claire au lieu de planter.
RESEND_API_KEY=your_resend_api_key_here

# Adresse validée dans Resend. Exemple :
# RESEND_FROM_EMAIL="Uncommon People Tribe <bonjour@uncommonpeopletribe.com>"
RESEND_FROM_EMAIL=

# Segment Resend dans lequel enregistrer les abonnés à la newsletter.
RESEND_SEGMENT_ID=

# Code envoyé automatiquement après l'inscription à la newsletter.
NEWSLETTER_WELCOME_CODE=

# Boutique Shopify Headless / Storefront API.
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=your_storefront_access_token
SHOPIFY_STOREFRONT_API_VERSION=2026-07

# Correspondance entre les variantes du site et leurs ProductVariant GID Shopify.
# Les clés suivent le format produit:couleur:taille. Les variantes absentes sont indisponibles.
SHOPIFY_VARIANTS_JSON='{"polo-signature-up:noir:M":"gid://shopify/ProductVariant/0000000001","tee-shirt-la-yole:noir:S":"gid://shopify/ProductVariant/0000000002"}'
